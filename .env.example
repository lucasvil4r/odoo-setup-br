# Copie para .env e ajuste por cliente:  cp .env.example .env
# O .env NÃO é versionado. O .env.example é.

# Nome do projeto/cliente. Vira o nome do banco e o prefixo dos containers.
# Use minúsculas, sem espaços nem hífens (o Postgres não gosta).
PROJECT=acme

# Senha mestre do Odoo (tela de gerenciamento de bancos).
# TROQUE ANTES DE QUALQUER AMBIENTE QUE NÃO SEJA SUA MÁQUINA.
ADMIN_PASSWD=troque-me

# Credenciais do PostgreSQL. Só valem para este ambiente local.
DB_USER=odoo
DB_PASSWORD=odoo

# Porta em que o Odoo responde no host.
ODOO_PORT=8069

# 0 = modo desenvolvimento (sem multiprocessing, permite debugger).
# Em produção, use 2 * núcleos + 1.
WORKERS=0
LOG_LEVEL=info
